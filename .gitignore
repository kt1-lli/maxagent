.agent
*.pyc
__pycache__

# 用户数据目录（运行时由 maxagent.config 创建在包同级位置）
# 包含 config.json / sessions/ / skills/ / user_tools/ / ui_state.json 等
_userdata/

# 旧版用户数据残留（兼容老分支，避免误提交个人 API Key）
.maxagent/

# 对话上传的临时图片（用户问问题附带的截图，非项目资产）
chat_uploads/

# coredump 文件，禁止入库
core.*

# 引用 / 双仓协作工作区（不属于 maxagent 仓库）
_ref/
dcc-mcp/
dcc-mcp-work/
dcc-mcp-ref/

# 发布流水线中间产物 / 最终产物
release/build_cache/
release/dist/

# Cython 编译副产物（仅限 release 工作区，避免误伤未来包内 C 资源）
release/**/*.c
release/**/*.so
release/**/*.pyd

# 测试用例：仅本地/开发使用，不随开源仓库分发
tests/
pytest.ini
# PyArmor 遗留调试日志
pyarmor.bug.log
